# Copy this file to .env and fill in your own values.

# Postgres connection string. Required — the server refuses to start without it.
# For local dev, point this at a local Postgres or a free dev branch on
# Neon (https://neon.tech) or Supabase (https://supabase.com).
# Neon/Supabase connection strings include "?sslmode=require", which the server
# detects automatically to enable TLS.
DATABASE_URL=postgres://user:password@localhost:5432/tradescrim

# Secret used to sign login session JWTs. Use a long random string.
# If unset, the server generates a random one at startup (sessions won't
# survive a server restart) — set this for stable sessions.
JWT_SECRET=replace-with-a-long-random-string

# Port the API server listens on. Most hosting platforms set this for you.
PORT=4000

# Comma-separated list of origins allowed to call the API with credentials.
# In production, set this to your deployed frontend's URL(s).
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173

# Set to "production" when deployed. Enables Secure, cross-site (SameSite=None)
# cookies, required once the frontend and backend are on different domains, and
# scopes the cookie's Domain to ".tradescrim.com" (see COOKIE_DOMAIN in
# routes/auth.js) so it's shared between tradescrim.com and api.tradescrim.com —
# this only works if the backend is actually served from a *.tradescrim.com
# subdomain, since a browser rejects a Domain attribute that isn't the current
# host or one of its parents. iOS (Safari and every other iOS browser, which
# must use WebKit) blocks third-party SameSite=None cookies outright, so without
# this same-site setup Google/session cookies silently fail to persist on iPhones
# even though the login flow appears to succeed.
NODE_ENV=development

# Google sign-in (optional). Create an OAuth 2.0 Client ID (Web application) at
# https://console.cloud.google.com/apis/credentials. Leave unset to disable the
# "Continue with Google" button.
# GOOGLE_REDIRECT_URI must exactly match an "Authorized redirect URI" on that
# client, and must point at THIS server (not the frontend): <this server's public
# URL>/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Where to send the browser after a successful Google login. Only needed if this
# differs from CLIENT_ORIGIN above — e.g. if the frontend is ever hosted at a
# subpath instead of a domain's root, since CLIENT_ORIGIN must stay a bare origin
# for CORS to match. Leave unset to fall back to CLIENT_ORIGIN.
# CLIENT_APP_URL=https://tradescrim.com

# Powers the News tab and the Bull or Bear game. Get a free key at
# https://finnhub.io/register (free tier: 60 requests/minute, licensed for
# production use — unlike NewsAPI.org's free tier, which is dev-only).
# Without this set, News shows an error and Bull or Bear can't load rounds.
FINNHUB_API_KEY=
